{% if collection %}
  {% assign current_collection_url = collection.url %}
<div class="price-range-filter">
  <h4 class="filter-title">Price</h4>
  <ul class="price-ranges">
    {% assign price_ranges = '500-1000,1000-1500,1500-2000,2500-3000,3000-4000,4000-4500,4500-5000,5000-6000,6000-7000' | split: ',' %}
    {% for range in price_ranges %}
      {% assign parts = range | split: '-' %}
      <li>
        <a
          href="{{ current_collection_url }}?filter.v.price.gte={{ parts[0] }}&filter.v.price.lte={{ parts[1] }}"
          class="price-range-link"
          {% comment %} Open in new tab if needed {% endcomment %}
          target="_self"
        >
          ₹{{ parts[0] }} – ₹{{ parts[1] }}
        </a>
      </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
{% schema %}
{
  "name": "Price",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    
  ],
  "presets": [
    {
      "name": "Price"
    }
  ]
}
{% endschema %}