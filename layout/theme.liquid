    <!-- GA4 Client ID Retrieval Script -->
    <script>
      (function() {
        try {
          if (typeof gtag === 'function') {
            gtag('get', 'G-82P61PP9VE', 'client_id', function(clientId) {
              if (clientId) {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                  'event': 'gaClientIdRetrieved',
                  'ga_client_id': clientId
                });
              }
            });
          }
        } catch (e) {
          // console.error('Error retrieving GA4 client_id:', e);
        }
      })();
    </script>

    <!-- Add GA4 Client ID as Cart Attribute -->
    <script>
      function addGaClientIdToCart(ga4ClientId) {
        if (!ga4ClientId) return;

        if (typeof jQuery !== 'undefined') {
          jQuery.ajax({
            type: 'POST',
            url: '/cart/update.js',
            data: {
              attributes: {
                'ga_client_id': ga4ClientId
              }
            },
            dataType: 'json'
          });
        }
      }

      window.dataLayer = window.dataLayer || [];

      window.addEventListener('DOMContentLoaded', function () {
        var ga4ClientId = window.dataLayer.find(item => item.ga_client_id !== undefined)?.ga_client_id;

        if (ga4ClientId) {
          addGaClientIdToCart(ga4ClientId);
        } else {
          // Wait for the ga_client_id to be pushed to the dataLayer
          var originalPush = window.dataLayer.push;

          window.dataLayer.push = function () {
            for (var i = 0; i < arguments.length; i++) {
              var item = arguments[i];
              if (item && item.ga_client_id) {
                addGaClientIdToCart(item.ga_client_id);
              }
            }
            return originalPush.apply(window.dataLayer, arguments);
          };
        }
      });
    </script>

