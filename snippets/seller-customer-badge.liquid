<!-- seller cavirk -->
{% if product.vendor == 'Cavirk' %}
  <div class="seller_badge_config flex" style="gap: 5px;margin-left: 8px;">
    <picture>
      {{-
        image
        | image_url: "https://cdn.shopify.com/s/files/1/0866/5507/4578/files/shield.png?v=1763451591"
        | image_tag:
          loading: loading,
          width: 18px,
          height: 18px,
          alt: image_alt
      -}}
    </picture>
    <span style="margin: 0;line-height: normal;">Cavirk Verified</span>
  </div>
{% endif %}
