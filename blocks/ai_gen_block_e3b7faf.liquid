{% doc %}
  @prompt
    Show three images in a horizontal view, each image should have a title and a button below it. Display only the three images. Make the layout responsive for mobile with a scrollable slide view. Also provide a section heading, subheading, and description. The images should have options for adaptive ratio, square, and portrait.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-gallery-container-{{ ai_gen_id }} {
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-gallery-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-image-gallery-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    font-weight: 400;
    text-transform: {{ block.settings.heading_text_transform }};
  }

  .ai-image-gallery-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 16px;
    font-weight: 400;
  }

  .ai-image-gallery-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-image-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-image-gallery-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-image-gallery-item-{{ ai_gen_id }}:hover {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }}--adaptive {
    aspect-ratio: auto;
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }}--square {
    aspect-ratio: 1 / 1;
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }}--portrait {
    aspect-ratio: 3 / 4;
  }

  .ai-image-gallery-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }


  .ai-image-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-image-gallery-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-gallery-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-image-gallery-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 12px;
    font-weight: 400;
    text-transform: {{ block.settings.title_text_transform }};
  }

  .ai-image-gallery-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    text-transform: {{ block.settings.button_text_transform }};
    transition: all 0.3s ease;
    margin: auto;
    width: fit-content;
    border: none;
    cursor: pointer;

  }

  .ai-image-gallery-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-image-gallery-grid-{{ ai_gen_id }} {
      {% comment %} display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 20px;
      padding-bottom: 10px;
      -webkit-overflow-scrolling: touch; {% endcomment %}
      grid-template-columns: repeat(1, 1fr);
    }

    .ai-image-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 280px;
      scroll-snap-align: start;
    }

    .ai-image-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      height: 4px;
    }

    .ai-image-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 2px;
    }

    .ai-image-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
      background: {{ block.settings.button_background_color }};
      border-radius: 2px;
    }

    .ai-image-gallery-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-image-gallery-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-image-gallery-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-image-gallery-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-image-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 250px;
    }

    .ai-image-gallery-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-image-gallery-{{ ai_gen_id }} {{ block.settings.section_width }}" {{ block.shopify_attributes }}>
  <div class="ai-image-gallery-container-{{ ai_gen_id }} {% if block.settings.section_width == 'full_width' %} px-20 {% endif %}">
    {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.description != blank %}
      <div class="ai-image-gallery-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-image-gallery-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        
        {% if block.settings.subheading != blank %}
          <h3 class="ai-image-gallery-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</h3>
        {% endif %}
        
        {% if block.settings.description != blank %}
          <div class="ai-image-gallery-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-image-gallery-grid-{{ ai_gen_id }}">
      {% for i in (1..2) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign title_key = 'title_' | append: i
          assign button_text_key = 'button_text_' | append: i
          assign button_link_key = 'button_link_' | append: i
          
          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
          assign button_text = block.settings[button_text_key]
          assign button_link = block.settings[button_link_key]
        %}
        
        <div class="ai-image-gallery-item-{{ ai_gen_id }}">
          <div class="ai-image-gallery-image-wrapper-{{ ai_gen_id }} ai-image-gallery-image-wrapper-{{ ai_gen_id }}--{{ block.settings.image_aspect_ratio }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                class="ai-image-gallery-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-image-gallery-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-image-gallery-empty-state-{{ ai_gen_id }}">
                  Add image {{ i }}
                </div>
              </div>
            {% endif %}
          </div>
          
          <div class="ai-image-gallery-content-{{ ai_gen_id }}">
            {% if title != blank %}
              <h4 class="ai-image-gallery-title-{{ ai_gen_id }}">{{ title }}</h4>
            {% endif %}
            
            {% if button_text != blank %}
              {% if button_link != blank %}
                <a href="{{ button_link }}" class="ai-image-gallery-button-{{ ai_gen_id }} btn">
                  {{ button_text }}
                </a>
              {% else %}
                <button class="ai-image-gallery-button-{{ ai_gen_id }} btn">
                  {{ button_text }}
                </button>
              {% endif %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

