{% doc %}
  @prompt
    Show three images in a horizontal view, each image should have a title and a button below it. Display only the three images. Make the layout responsive for mobile with a scrollable slide view. Also provide a section heading, subheading, and description. The images should have options for adaptive ratio, square, and portrait.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-image-gallery-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-gallery-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-image-gallery-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    text-transform: {{ block.settings.heading_transform }};
  }

  .ai-image-gallery-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    font-weight: {{ block.settings.subheading_weight }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
  }

  .ai-image-gallery-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-image-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.content_spacing }}px;
  }

  .ai-image-gallery-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-image-gallery-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_lift | times: 2 }}px {{ block.settings.hover_lift | times: 4 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }}--adaptive {
    aspect-ratio: auto;
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }}--square {
    aspect-ratio: 1 / 1;
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }}--portrait {
    aspect-ratio: 3 / 4;
  }

  .ai-image-gallery-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-image-gallery-item-{{ ai_gen_id }}:hover .ai-image-gallery-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-image-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-image-gallery-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-gallery-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    text-align: {{ block.settings.card_text_alignment }};
  }

  .ai-image-gallery-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    flex-grow: 1;
  }

  .ai-image-gallery-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-transform: {{ block.settings.button_text_transform }};
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    margin-top: auto;
  }

  .ai-image-gallery-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 768px) {
    .ai-image-gallery-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ block.settings.mobile_gap }}px;
      padding-bottom: 10px;
      margin-left: -20px;
      margin-right: -20px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .ai-image-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_item_width }}%;
      scroll-snap-align: start;
    }

    .ai-image-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      height: 4px;
    }

    .ai-image-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 2px;
    }

    .ai-image-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
      background: {{ block.settings.scrollbar_color }};
      border-radius: 2px;
    }

    .ai-image-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
      background: {{ block.settings.scrollbar_hover_color }};
    }

    .ai-image-gallery-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-image-gallery-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-image-gallery-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-image-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_item_width | plus: 10 }}%;
    }
  }
{% endstyle %}

<div class="ai-image-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-gallery-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.description != blank %}
      <div class="ai-image-gallery-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-image-gallery-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        
        {% if block.settings.subheading != blank %}
          <h3 class="ai-image-gallery-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</h3>
        {% endif %}
        
        {% if block.settings.description != blank %}
          <div class="ai-image-gallery-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-image-gallery-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign title_key = 'title_' | append: i
          assign button_text_key = 'button_text_' | append: i
          assign button_link_key = 'button_link_' | append: i
          
          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
          assign button_text = block.settings[button_text_key]
          assign button_link = block.settings[button_link_key]
        %}
        
        <div class="ai-image-gallery-item-{{ ai_gen_id }}">
          <div class="ai-image-gallery-image-wrapper-{{ ai_gen_id }} ai-image-gallery-image-wrapper-{{ ai_gen_id }}--{{ block.settings.image_ratio }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                class="ai-image-gallery-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-image-gallery-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-image-gallery-empty-state-{{ ai_gen_id }}">
                  Add image {{ i }}
                </div>
              </div>
            {% endif %}
          </div>
          
          <div class="ai-image-gallery-content-{{ ai_gen_id }}">
            {% if title != blank %}
              <h4 class="ai-image-gallery-title-{{ ai_gen_id }}">{{ title }}</h4>
            {% endif %}
            
            {% if button_text != blank %}
              <a
                href="{{ button_link | default: '#' }}"
                class="ai-image-gallery-button-{{ ai_gen_id }}"
              >
                {{ button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

